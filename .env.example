# Node 22.13+ is required. Do not commit real credentials or database files.
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/mogustack.sqlite

# Leave blank for localhost defaults (dev:4173, production:3001).
# For deployment, set PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_ORIGIN=

# If running behind one trusted reverse proxy, set TRUST_PROXY=1.
TRUST_PROXY=0
